# Redirect HTTP to HTTPS
server {
    listen 80;
    server_name api.example.test;
    return 301 https://$host$request_uri;
}

# Rate-limit zones (tune after first 24h telemetry)
limit_req_zone $binary_remote_addr zone=login_per_ip:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=keygen_per_ip:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=support_per_ip:10m rate=30r/m;
limit_req_zone $http_x_api_key zone=support_per_key:10m rate=120r/m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl http2;
    server_name api.example.test;

    ssl_certificate /etc/letsencrypt/live/api.example.test/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.test/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Baseline hardening
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    client_max_body_size 2m;

    location = /v1/auth/login {
        limit_req zone=login_per_ip burst=10 nodelay;
        proxy_pass http://127.0.0.1:8089;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /v1/auth/generate-api-key {
        limit_req zone=keygen_per_ip burst=6 nodelay;
        proxy_pass http://127.0.0.1:8089;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /v1/support/ws/updates {
        proxy_pass http://127.0.0.1:8089;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600;
    }

    location /v1/support/ {
        limit_req zone=support_per_ip burst=30 nodelay;
        limit_req zone=support_per_key burst=120 nodelay;
        proxy_pass http://127.0.0.1:8089;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        proxy_pass http://127.0.0.1:8089;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}