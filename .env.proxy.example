# Public IPv4 on API server where the dedicated chat Caddy should bind.
# Keep this server-local and do not commit real production IPs.
SUPPORT_API_PUBLIC_BIND_IPV4=203.0.113.10

# Public IPv6 on API server where the dedicated chat Caddy should bind.
# Use plain IPv6 without brackets, for example: 2001:db8::10
SUPPORT_API_PUBLIC_BIND_IPV6=2001:db8::10

# Public hostname for the support API
SUPPORT_API_FQDN=api.example.test

# ACME notification contact for TLS certificates
ACME_EMAIL=ops@example.test
